{
  "name": "@cortex/app-sdk",
  "version": "0.1.0",
  "description": "Call Cortex host functions from a Cortex App Store app — and keep running when Cortex is not there.",
  "keywords": ["cortex", "app-store", "sdk", "host-bridge"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appfactory123/Cortex-AI.git",
    "directory": "packages/app-sdk"
  },
  "homepage": "https://github.com/appfactory123/Cortex-AI/tree/main/packages/app-sdk#readme",
  "bugs": "https://github.com/appfactory123/Cortex-AI/issues",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": ["index.mjs", "index.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
