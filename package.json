{
  "name": "@cortex/app-sdk",
  "version": "0.3.0",
  "description": "Call Cortex host functions from a Cortex App Store app — and keep running when Cortex is not there.",
  "keywords": [
    "cortex",
    "app-store",
    "sdk",
    "host-bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appfactory123/cortex-app-sdk.git"
  },
  "homepage": "https://github.com/appfactory123/cortex-app-sdk#readme",
  "bugs": "https://github.com/appfactory123/cortex-app-sdk/issues",
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "import": "./browser.mjs"
    },
    "./ag-ui": {
      "types": "./ag-ui.d.ts",
      "import": "./ag-ui.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "browser.mjs",
    "browser.d.ts",
    "README.md",
    "LICENSE",
    "ag-ui.mjs",
    "ag-ui.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
